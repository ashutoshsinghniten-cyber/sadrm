.idea/workspace.xml
.idea/tasks.xml
.idea/usage.statistics.xml
.idea/dictionaries/
.idea/shelf/
.idea/aws.xml
.idea/httpRequests/
.idea/dataSources/
.idea/dataSources.local.xml
.idea/sqlDataSources.xml
.idea/dynamic.classpath
.idea/uiDesigner.xml
.idea/*.iml
*.iml
*.ipr
*.iws

# ─── Eclipse ──────────────────────────────────────────────────────────────────
.classpath
.project
.settings/
.springBeans
.sts4-cache/

# ─── VS Code ──────────────────────────────────────────────────────────────────
.vscode/

# ─── Claude Code ──────────────────────────────────────────────────────────────
.claude/settings.local.json

# ─── Patch Files ──────────────────────────────────────────────────────────────
*.patch
*.orig

